# Reverse proxy in front of the app (docs/DEPLOY.md).
# DOMAIN=crm.example.uz  -> automatic HTTPS with a Let's Encrypt certificate.
# DOMAIN=:80             -> plain HTTP on the server's IP (then set COOKIE_SECURE=false).
#
# A centre's own address (Settings -> Organisations -> Own address, A-114) is
# served by the catch-all block below: its certificate is fetched on the first
# visit, after the app has confirmed the name at /api/v1/public/tls-ask.
{
	on_demand_tls {
		ask http://app:3000/api/v1/public/tls-ask
	}
}

{$DOMAIN} {
	encode gzip
	reverse_proxy app:3000
}

# The address this server had before (FORMER_DOMAIN, docs/DEPLOY.md section 13).
# Pages opened under the old name are sent to the same page under the new one, so
# links people saved or were sent keep working. /api keeps answering under the
# old name, because Telegram, Payme and Click call the address they were given
# and do not follow a redirect. Without FORMER_DOMAIN the block is a plain-http
# site for a name nobody can reach, so no certificate is asked for.
{$FORMER_DOMAIN:http://former-address.invalid} {
	encode gzip
	@pages not path /api/*
	redir @pages https://{$DOMAIN}{uri}
	reverse_proxy app:3000
}

https:// {
	tls {
		on_demand
	}
	encode gzip
	reverse_proxy app:3000
}

http:// {
	redir https://{host}{uri} permanent
}
