# Copy to .env and adjust. Never commit .env.

# PostgreSQL connection string used by the app and by Prisma migrations.
DATABASE_URL="postgresql://kampus:kampus@localhost:5432/kampus?schema=public"

# Base URL of the app (used for Origin checks and e2e tests).
APP_URL="http://localhost:3000"

# Set to "false" to allow the session cookie over plain http in production-like
# setups without TLS (e.g. docker-compose on a LAN). Defaults to secure in production.
# COOKIE_SECURE="false"
# Emergency only: accept a staff password even from someone who has never signed in with
# Telegram (the first sign-in is normally a Telegram code, A-196).
# STAFF_PASSWORD_LOGIN="on"
# The address the public pages /privacy and /delete-account name for questions (A-267).
# Google Play asks for a privacy contact; without it the pages send people to their centre.
# LEGAL_CONTACT_EMAIL="privacy@example.com"

# Seed script: credentials of the demo CEO account. Fake data only.
SEED_ADMIN_PHONE="+998900000001"
SEED_ADMIN_PASSWORD="Kampus!2026"

# Optional: path to a pre-installed Chromium for Playwright (skips the browser download)
# PLAYWRIGHT_CHROMIUM_PATH=/usr/bin/chromium

# Where uploaded files are stored (local disk adapter)
UPLOAD_DIR=uploads

# The how-to videos the Help pages play: <folder>/<en|ru|uz>/01-sign-in.mp4 and so on,
# as `npm run help:videos` writes them. Videos that are not there are simply not shown.
# HELP_VIDEOS_DIR=help-videos

# Or keep files in S3-compatible object storage (Hetzner Object Storage, MinIO, AWS S3)
# instead of the disk; see docs/DEPLOY.md "Object storage".
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://fsn1.your-objectstorage.com
# S3_REGION=fsn1
# S3_BUCKET=kampus-files
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_FORCE_PATH_STYLE=false

# Background worker (npm run worker): how often it polls the job queue, in ms.
# WORKER_INTERVAL_MS=5000

# Integrations (Eskiz SMS, Telegram bot, AmoCRM, telephony, FaceID) are configured
# in the app under Settings → Integrations, not here. Webhook secrets live there too.
