# Copy to .env and adjust. Never commit .env.

# PostgreSQL connection string used by the app and by Prisma migrations.
DATABASE_URL="postgresql://kampus:kampus@localhost:5432/kampus?schema=public"

# Base URL of the app (used for Origin checks and e2e tests).
APP_URL="http://localhost:3000"

# Set to "false" to allow the session cookie over plain http in production-like
# setups without TLS (e.g. docker-compose on a LAN). Defaults to secure in production.
# COOKIE_SECURE="false"

# Seed script: credentials of the demo CEO account. Fake data only.
SEED_ADMIN_PHONE="+998900000001"
SEED_ADMIN_PASSWORD="Kampus!2026"

# Optional: path to a pre-installed Chromium for Playwright (skips the browser download)
# PLAYWRIGHT_CHROMIUM_PATH=/usr/bin/chromium

# Where uploaded photos are stored (local disk adapter)
UPLOAD_DIR=uploads

# Background worker (npm run worker): how often it polls the job queue, in ms.
# WORKER_INTERVAL_MS=5000

# Integrations (Eskiz SMS, Telegram bot, AmoCRM, telephony, FaceID) are configured
# in the app under Settings → Integrations, not here. Webhook secrets live there too.
