# Production settings for docker-compose.prod.yml (docs/DEPLOY.md).
# Copy to .env on the server and fill in. Never commit .env.

# Database password used inside the compose network. Letters and digits only
# (it is embedded in a URL). Generate one: openssl rand -hex 24
POSTGRES_PASSWORD=

# Public address. With a domain, Caddy fetches a free HTTPS certificate:
#   DOMAIN=crm.example.uz        APP_URL=https://crm.example.uz
# Without a domain (plain http on the server IP, for a first test only):
#   DOMAIN=:80                   APP_URL=http://203.0.113.10   COOKIE_SECURE=false
DOMAIN=
APP_URL=
# COOKIE_SECURE=false

# First start only: the organisation, its first branch and the CEO login.
# Ignored once an organisation exists, so these lines can be removed afterwards.
BOOTSTRAP_ORG_NAME=
BOOTSTRAP_BRANCH_NAME=
BOOTSTRAP_CEO_NAME=
BOOTSTRAP_CEO_PHONE=+998
BOOTSTRAP_CEO_PASSWORD=
# Name of the first payment method (default "Cash").
# BOOTSTRAP_CASH_NAME=Naqd

# TURN relay for video lessons (the `turn` service). The public IP of this
# server, the relay address the browsers get, and a shared secret:
#   openssl rand -hex 24
TURN_PUBLIC_IP=
TURN_URLS=turn:203.0.113.10:3478?transport=udp, turn:203.0.113.10:3478?transport=tcp
TURN_SECRET=

# Background worker polling interval in ms (default 5000).
# WORKER_INTERVAL_MS=5000

# Nightly database dumps in ./backups are kept this many days (default 14).
# BACKUP_KEEP_DAYS=14
