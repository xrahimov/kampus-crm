// Kampus CRM — Prisma schema.
// Phase 2 (skeleton): organisation, branches, users, roles, sessions, logs.
// Later phases add their own models in the sections marked below.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Organisation & branches (EXP §0 branch selector, §8 general settings)
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String?
  /// The centre's own address (A-114), e.g. "kingston.kampus.uz": the login page
  /// carries its name there and student links use it. Null = the server's domain.
  domain    String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches          Branch[]
  users             User[]
  roles             Role[]
  auditLogs         AuditLog[]
  settings          OrgSettings?
  paymentMethods    PaymentMethod[]
  gradingSystems    GradingSystem[]
  schools           School[]
  leadSources       LeadSource[]
  receiptSettings   ReceiptSettings?
  leadForms         LeadForm[]
  financeCategories FinanceCategory[]
  payrollRuns       PayrollRun[]
  coinRules         CoinRule[]
  coinReasons       CoinReason[]
  productCategories ProductCategory[]
  products          Product[]
  questions         QuestionBankItem[]
  tests             Test[]
  smsCategories     SmsCategory[]
  smsTemplates      SmsTemplate[]
  autoSmsSettings   AutoSmsSetting[]
  smsMessages       SmsMessage[]
  callLogs          CallLog[]
  botRecipients     BotRecipient[]
  integrations      IntegrationSetting[]
  leaveReasons      LeaveReason[]
  cashCloses        CashClose[]
  families          Family[]
}

model Branch {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id])
  users          UserBranch[]
  sessions       Session[]
  auditLogs      AuditLog[]
  courses        Course[]
  rooms          Room[]
  daysOff        DayOff[]
  groups         Group[]
  students       Student[]
  payments       Payment[]
  leadBoards     LeadBoard[]
  leads          Lead[]
  exams          Exam[]
  financeEntries FinanceEntry[]
  smsMessages    SmsMessage[]
  callLogs       CallLog[]
  staffCheckIns  StaffAttendance[]
  adjustments    BalanceAdjustment[]
  debtCases      DebtCase[]
  absenceCases   AbsenceCase[]
  cashCloses     CashClose[]

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Users, roles, permissions (EXP §8 Staff, Roles)
// ---------------------------------------------------------------------------

enum Gender {
  MALE
  FEMALE
}

/// Second step of the sign-in (A-124): nothing, or a code sent to the person's Telegram chat.
enum SignInCode {
  OFF
  TELEGRAM
}

/// How a teacher is paid (EXP §4 "Maosh hisoblash usuli"); see A-12.
enum SalaryMethod {
  PERCENT
  MONTHLY
  PER_LESSON
  PER_STUDENT
}

model User {
  id                 String        @id @default(cuid())
  /// The centre this account belongs to; a login is scoped to it (A-108).
  organizationId     String
  fullName           String
  phone              String        @unique // E.164, e.g. +998901234567
  passwordHash       String
  gender             Gender        @default(MALE)
  birthDate          DateTime?     @db.Date
  hireDate           DateTime?     @db.Date
  photoUrl           String?
  salaryMethod       SalaryMethod?
  fixedSalary        Decimal?      @db.Decimal(15, 2) // MONTHLY: UZS per month
  percentShare       Decimal?      @db.Decimal(5, 2) // PERCENT: % of course price
  perLessonFee       Decimal?      @db.Decimal(15, 2) // PER_LESSON: UZS per lesson
  perStudentFee      Decimal?      @db.Decimal(15, 2) // PER_STUDENT: UZS per active student
  isArchived         Boolean       @default(false)
  /// The person who runs the server: may create organisations for other centres (A-108).
  isSiteOwner        Boolean       @default(false)
  /// Someone else chose the password (a new account, an admin reset): the user picks their own at the next sign-in (A-124).
  mustChangePassword Boolean       @default(false)
  passwordChangedAt  DateTime?
  /// A one-time code by Telegram is asked for after the password (A-124).
  signInCode         SignInCode    @default(OFF)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id])
  roles           UserRole[]
  branches        UserBranch[]
  sessions        Session[]
  loginLogs       LoginLog[]
  loginChallenges LoginChallenge[]
  auditLogs       AuditLog[]

  groupsTaught    GroupTeacher[]
  groupsSupported GroupSupportTeacher[] @relation("supportOf")
  groupNotes      GroupNote[]

  paymentsReceived   Payment[]
  refundsMade        Refund[]
  cashClosesMade     CashClose[]      @relation("cashCloseCashier")
  cashClosesAccepted CashClose[]      @relation("cashCloseAcceptor")
  instalmentsCreated Instalment[]     @relation("instalmentCreator")
  discountsGiven     Discount[]
  studentComments    StudentComment[]

  leadsAssigned Lead[]        @relation("leadTeacher")
  leadsCreated  Lead[]        @relation("leadCreator")
  leadsOwned    Lead[]        @relation("leadOwner")
  leadContacts  LeadContact[] @relation("leadContactAuthor")

  examsExamined   Exam[]         @relation("examiner")
  financeEntries  FinanceEntry[] @relation("financeStaff")
  financeCreated  FinanceEntry[] @relation("financeCreator")
  payrollLines    PayrollLine[]
  payrollApproved PayrollLine[]  @relation("payrollApprover")
  notifications   Notification[]
  examsGraded     ExamResult[]   @relation("examGrader")

  coinsGiven       CoinTransaction[]  @relation("coinGiver")
  purchasesCreated PurchaseRequest[]  @relation("purchaseCreator")
  purchasesDecided PurchaseRequest[]  @relation("purchaseDecider")
  questionsWritten QuestionBankItem[] @relation("questionAuthor")

  smsSent           SmsMessage[]         @relation("smsSender")
  calls             CallLog[]            @relation("callStaff")
  botRecipient      BotRecipient?
  staffCheckIns     StaffAttendance[]
  workSchedules     WorkSchedule[]
  membershipsClosed GroupMembership[]    @relation("membershipsClosed")
  testsWritten      Test[]               @relation("testAuthor")
  attemptsEntered   TestAttempt[]        @relation("attemptEnteredBy")
  videoRoomsStarted VideoRoom[]          @relation("videoRoomStarter")
  videoPeers        VideoParticipant[]
  homeworkSet       Homework[]           @relation("homeworkAuthor")
  homeworkChecked   HomeworkSubmission[] @relation("homeworkChecker")
  materialsAdded    LessonMaterial[]     @relation("materialAuthor")
  adjustmentsMade   BalanceAdjustment[]  @relation("adjustmentAuthor")
  debtContacts      DebtContact[]        @relation("debtContactAuthor")
  absenceContacts   AbsenceContact[]     @relation("absenceContactAuthor")

  @@index([organizationId])
}

/// A role is a named bundle of permission codes. System roles are seeded and
/// cannot be deleted; the CEO can create custom roles (EXP §8 Roles (Beta)).
model Role {
  id             String   @id @default(cuid())
  /// Null for the system roles every centre shares; custom roles belong to one centre (A-108).
  organizationId String?
  code           String   @unique // e.g. CEO, ADMIN, TEACHER, or custom:branch-manager
  name           String
  isSystem       Boolean  @default(false)
  isActive       Boolean  @default(true)
  permissions    String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        UserRole[]

  @@index([organizationId])
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model UserBranch {
  userId   String
  branchId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@index([branchId])
}

// ---------------------------------------------------------------------------
// Auth: sessions, login rate limiting, login log (EXP §8 "Tizimga kirishlar")
// ---------------------------------------------------------------------------

model Session {
  id             String   @id @default(cuid())
  tokenHash      String   @unique // sha256 of the opaque cookie token
  userId         String
  activeBranchId String?
  csrfSecret     String
  ip             String?
  userAgent      String?
  expiresAt      DateTime
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeBranch Branch? @relation(fields: [activeBranchId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
}

/// One row per failed login, keyed by phone and by IP. Counted in a sliding
/// window to lock out brute force (see server/auth/rate-limit.ts).
model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model LoginLog {
  id        String   @id @default(cuid())
  userId    String?
  phone     String
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdAt])
}

/// A sign-in that passed the password and waits for the Telegram code (A-124).
/// Deleted once used, expired or after too many wrong codes.
model LoginChallenge {
  id             String   @id
  userId         String
  codeHash       String
  attempts       Int      @default(0)
  activeBranchId String?
  ip             String?
  userAgent      String?
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Audit log for every create/update/delete (EXP §5 group history,
// §6 student history, §8 action log)
// ---------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(cuid())
  /// The centre the change belongs to, so org-level entries (settings, roles) stay inside it (A-108).
  organizationId String?
  actorId        String?
  branchId       String?
  action         String // e.g. group.update
  entity         String // e.g. Group
  entityId       String
  before         Json?
  after          Json?
  ip             String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([entity, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([organizationId, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Settings core (Phase 3, EXP §8 "Umumiy sozlamalar", Kurslar, Xonalar,
// Dam olish kunlari, Maktablar)
// ---------------------------------------------------------------------------

/// The switches on the "Markaz sozlamalari" tab, one row per organisation.
/// Each flag is read by the module it governs in a later phase.
model OrgSettings {
  id             String @id @default(cuid())
  organizationId String @unique

  spreadOverpayment          Boolean @default(false) // overpayment is spread over the next months
  adminActionsNeedApproval   Boolean @default(false) // admin actions wait for CEO approval (A-09)
  printReceiptAfterPayment   Boolean @default(false)
  refundsEnabled             Boolean @default(false)
  attendanceComments         Boolean @default(false)
  teachersSeeExamSchedule    Boolean @default(false)
  attendanceOnlyDuringLesson Boolean @default(false)
  teacherSeesSalary          Boolean @default(false)
  payTeacherOnGroupDayOff    Boolean @default(false)
  payOnlyAttendedLessons     Boolean @default(false)
  teacherCanAddStudents      Boolean @default(false)
  bookAnySupportTeacher      Boolean @default(false)
  groupSupportSessions       Boolean @default(false)
  /// "Avtomatik coin tizimi" (EXP §8 Coins); manual coins work regardless.
  autoCoins                  Boolean @default(false)

  workStart           String @default("08:00") // HH:mm, schedule grid start
  workEnd             String @default("20:00") // HH:mm, schedule grid end
  scheduleStepMinutes Int    @default(30) // 15 or 30

  /// Debt collection cadence (A-112): days after a debt appears until the student is
  /// reminded on Telegram, then by SMS, then the branch managers get a task. Null = off.
  debtTelegramDays  Int? @default(1)
  debtSmsDays       Int? @default(3)
  debtTaskDays      Int? @default(7)
  /// Absence follow-up (A-125): lessons missed in a row, and days without a present mark,
  /// before a student lands on the list; null switches that rule off.
  absenceStreak     Int? @default(2)
  absenceSilentDays Int? @default(14)

  /// Public page per centre (A-121): courses, prices, timetable, teachers and the sign-up form,
  /// at the centre's own address and at /c/<publicSlug> on the server's.
  publicPage      Boolean @default(false)
  publicSlug      String? @unique
  publicIntro     String?
  publicPhone     String?
  publicAddress   String?
  publicInstagram String?
  publicTelegram  String?
  publicFormId    String?

  /// Referral programme (A-120): so'm credited to the referrer as a payment bonus
  /// when a friend they brought joins a group. 0 = coins only (the REFERRAL coin rule).
  referralBonus Int @default(0)

  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  publicForm   LeadForm?    @relation(fields: [publicFormId], references: [id], onDelete: SetNull)
}

/// "To'lov usullari" on the general settings tab. Payments reference these from Phase 6.
model PaymentMethod {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  isActive       Boolean  @default(true)
  /// Counted at the cashier's day close (A-122): money in the drawer, unlike cards or transfers.
  isCash         Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payments       Payment[]
  financeEntries FinanceEntry[]

  @@unique([organizationId, name])
}

enum RoundingType {
  STANDARD
  IELTS
}

/// "Baholash tizimlari": a named scale with ordered levels (A-16).
model GradingSystem {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  rounding       RoundingType @default(STANDARD)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  levels       GradingLevel[]
  courses      Course[]
  groups       Group[]
  exams        Exam[]

  @@unique([organizationId, name])
}

model GradingLevel {
  id              String  @id @default(cuid())
  gradingSystemId String
  name            String
  minScore        Decimal @db.Decimal(6, 2)
  maxScore        Decimal @db.Decimal(6, 2)
  sortOrder       Int     @default(0)

  gradingSystem GradingSystem @relation(fields: [gradingSystemId], references: [id], onDelete: Cascade)

  @@index([gradingSystemId, sortOrder])
}

/// "Kurslar": per branch, with a monthly price and duration in months.
model Course {
  id              String   @id @default(cuid())
  branchId        String
  name            String
  description     String?
  price           Decimal  @db.Decimal(15, 2) // UZS per month
  durationMonths  Int
  gradingSystemId String?
  color           String? // hex, e.g. #0F766E
  isArchived      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  branch        Branch         @relation(fields: [branchId], references: [id])
  gradingSystem GradingSystem? @relation(fields: [gradingSystemId], references: [id], onDelete: SetNull)
  groups        Group[]

  @@index([branchId, isArchived])
  @@index([gradingSystemId])
}

/// "Xonalar": per branch, with a seat capacity.
model Room {
  id        String   @id @default(cuid())
  branchId  String
  name      String
  capacity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch              @relation(fields: [branchId], references: [id])
  slots  GroupScheduleSlot[]
  exams  Exam[]

  @@unique([branchId, name])
}

/// "Dam olish kunlari": a date on which the branch holds no lessons.
model DayOff {
  id         String    @id @default(cuid())
  branchId   String
  date       DateTime  @db.Date
  reason     String
  /// Set when that day's groups were told (A-117).
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([branchId, date])
}

/// "Maktablar": the schools students attend (students reference them from Phase 6).
model School {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  students     Student[]
  leads        Lead[]
  forms        LeadForm[]

  @@unique([organizationId, name])
}

// --- Phase 5: groups, schedule, lessons, attendance (EXP §5) -----------------

enum GroupStatus {
  ACTIVE
  ARCHIVED
  TRIAL
  FROZEN
}

/// "Hafta kunlari": EVEN = Tue/Thu/Sat, ODD = Mon/Wed/Fri (A-50), EVERY_DAY = Mon–Sat, CUSTOM = chosen days.
enum WeekdayPattern {
  EVEN
  ODD
  EVERY_DAY
  CUSTOM
}

enum GroupTeacherRole {
  MAIN
  ASSISTANT
  CO_TEACHER
}

/// A teacher's share in one group ("Ulush turi", EXP §5); overrides the teacher's default (A-12).
enum ShareType {
  PERCENT
  PER_LESSON
  PER_STUDENT
}

enum MembershipStatus {
  NEW
  TRIAL
  ACTIVE
  FROZEN
  ARCHIVED
  GRADUATED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
  NOT_MARKED
}

model Group {
  id              String         @id @default(cuid())
  branchId        String
  courseId        String
  gradingSystemId String? // override; null = the course's system
  name            String
  weekdayPattern  WeekdayPattern @default(EVEN)
  startDate       DateTime       @db.Date
  endDate         DateTime       @db.Date
  status          GroupStatus    @default(ACTIVE)
  finishedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  branch          Branch                @relation(fields: [branchId], references: [id])
  course          Course                @relation(fields: [courseId], references: [id])
  gradingSystem   GradingSystem?        @relation(fields: [gradingSystemId], references: [id], onDelete: SetNull)
  slots           GroupScheduleSlot[]
  teachers        GroupTeacher[]
  supportTeachers GroupSupportTeacher[]
  daysOff         GroupDayOff[]
  lessons         Lesson[]
  notes           GroupNote[]
  memberships     GroupMembership[]
  studentComments StudentComment[]
  exams           Exam[]
  mockExams       ExamGroup[]
  coins           CoinTransaction[]
  tests           TestGroup[]
  testAttempts    TestAttempt[]
  videoRooms      VideoRoom[]
  homework        Homework[]
  materials       LessonMaterial[]
  absenceCases    AbsenceCase[]

  @@index([branchId, status])
  @@index([courseId])
}

/// One meeting per weekday (1 = Monday … 7 = Sunday), "HH:mm" times.
model GroupScheduleSlot {
  id        String  @id @default(cuid())
  groupId   String
  weekday   Int
  startTime String
  endTime   String
  roomId    String?

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  room  Room? @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@unique([groupId, weekday])
  @@index([roomId])
}

model GroupTeacher {
  id         String           @id @default(cuid())
  groupId    String
  userId     String
  role       GroupTeacherRole @default(MAIN)
  shareType  ShareType        @default(PERCENT)
  shareValue Decimal          @db.Decimal(15, 2)
  since      DateTime         @db.Date

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
  @@index([userId])
}

model GroupSupportTeacher {
  groupId String
  userId  String

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation("supportOf", fields: [userId], references: [id])

  @@id([groupId, userId])
  @@index([userId])
}

/// "Dam berish": a day the group does not meet; its lesson is removed (A-53).
/// "Dam berish": one date the group skips (A-53); since A-117 also a moved lesson with a notice.
model GroupDayOff {
  id              String    @id @default(cuid())
  groupId         String
  date            DateTime  @db.Date
  reason          String
  /// Start time of the lesson that was taken off, kept for the notice and the undo.
  startTime       String?
  /// When the lesson was moved rather than dropped: the extra lesson it moved to.
  movedToLessonId String?   @unique
  /// Set when the students and parents were told (Telegram, auto-SMS).
  notifiedAt      DateTime?
  createdAt       DateTime  @default(now())

  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  movedTo Lesson? @relation(fields: [movedToLessonId], references: [id], onDelete: SetNull)

  @@unique([groupId, date])
}

/// One meeting of a group, generated from the schedule or added as an extra lesson.
model Lesson {
  id            String   @id @default(cuid())
  groupId       String
  date          DateTime @db.Date
  startTime     String
  endTime       String
  topic         String?
  attachmentUrl String?
  isExtra       Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  group       Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  attendances Attendance[]
  grades      Grade[]
  videoRooms  VideoRoom[]
  homework    Homework?
  materials   LessonMaterial[]
  /// The day off this extra lesson replaces, when it was moved here (A-117).
  movedFrom   GroupDayOff?

  @@unique([groupId, date, startTime])
  @@index([groupId, date])
}

/// Student (EXP §6 profile). Phase 5 created the minimal row; Phase 6 adds the
/// profile fields, parents, custom fields, comments and payments.
model Student {
  id                 String    @id @default(cuid())
  branchId           String
  fullName           String
  phone              String?
  gender             Gender    @default(MALE)
  birthDate          DateTime? @db.Date
  photoUrl           String?
  /// Student app login (A-06): stored as observed, no app or portal in v1.
  passwordHash       String?
  /// One-time-use-many code behind the portal's "connect Telegram" link (A-103).
  telegramCode       String?   @unique
  /// The code behind the student's "invite a friend" link (A-120); made when first shown.
  referralCode       String?   @unique
  /// The student who brought this one (A-120): from the lead's referrer, or set by staff.
  referredById       String?
  /// When the referrer was credited for this student; set once, on the first membership.
  referralCreditedAt DateTime?
  /// Siblings share one family discount (A-123).
  familyId           String?
  /// "Manba": a lead source; the catalogue gets its own pages with leads (Phase 7).
  sourceId           String?
  schoolId           String?
  note               String?
  isBlacklisted      Boolean   @default(false)
  isArchived         Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  branch         Branch                @relation(fields: [branchId], references: [id])
  school         School?               @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  source         LeadSource?           @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  referredBy     Student?              @relation("referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals      Student[]             @relation("referrals")
  referredLeads  Lead[]                @relation("leadReferrer")
  family         Family?               @relation(fields: [familyId], references: [id], onDelete: SetNull)
  memberships    GroupMembership[]
  parents        Parent[]
  customFields   StudentCustomField[]
  comments       StudentComment[]
  payments       Payment[]
  onlinePayments OnlinePayment[]
  leads          Lead[]
  examResults    ExamResult[]
  financeEntries FinanceEntry[]
  coins          CoinTransaction[]
  purchases      PurchaseRequest[]
  testAttempts   TestAttempt[]
  smsMessages    SmsMessage[]
  callLogs       CallLog[]
  videoPeers     VideoParticipant[]
  telegramChats  StudentTelegramChat[]
  adjustments    BalanceAdjustment[]
  debtCases      DebtCase[]
  absenceCases   AbsenceCase[]

  @@index([branchId, isArchived])
  @@index([phone])
  @@index([schoolId])
  @@index([sourceId])
  @@index([referredById])
  @@index([familyId])
}

/// A Telegram chat (the student's own, or a parent's) that hears about the
/// student's lessons, homework and payments (A-103). Linked from the portal.
model StudentTelegramChat {
  id        String   @id @default(cuid())
  studentId String
  chatId    String   @unique
  /// Telegram first name, so the portal can say whose phone is connected.
  name      String?
  /// Telegram language_code narrowed to uz / ru / en; messages go out in it.
  locale    String   @default("uz")
  linkedAt  DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model GroupMembership {
  id          String           @id @default(cuid())
  groupId     String
  studentId   String
  status      MembershipStatus @default(ACTIVE)
  joinedAt    DateTime         @db.Date
  leftAt      DateTime?        @db.Date
  customPrice Decimal?         @db.Decimal(15, 2)
  note        String?
  /// First day the student is charged: when the membership became ACTIVE (A-10).
  activatedAt DateTime?        @db.Date
  /// Charged from this day instead when set (A-110): a member carried over from
  /// another system keeps the real join date while charging starts later.
  billingFrom DateTime?        @db.Date
  /// Set while FROZEN: lessons from this day on are not charged (A-59).
  frozenAt    DateTime?        @db.Date
  /// Why the student left (EXP §10 churn report reasons); picked from LeaveReason or typed.
  leaveReason String?
  /// Who closed the membership ("KIM TOMONIDAN CHIQARILGAN" in the churn report).
  leftById    String?
  leftBy      User?            @relation("membershipsClosed", fields: [leftById], references: [id])
  graduate    GraduateRecord?
  /// Personal link to the group's video lessons (/class/<token>); made on first use.
  videoToken  String?          @unique
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  group          Group                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student        Student              @relation(fields: [studentId], references: [id])
  attendances    Attendance[]
  grades         Grade[]
  discounts      Discount[]
  charges        Charge[]
  payments       Payment[]
  onlinePayments OnlinePayment[]
  homework       HomeworkSubmission[]
  adjustments    BalanceAdjustment[]
  instalments    Instalment[]
  absenceCases   AbsenceCase[]

  @@unique([groupId, studentId])
  @@index([studentId])
}

model Attendance {
  lessonId     String
  membershipId String
  status       AttendanceStatus @default(NOT_MARKED)
  comment      String?
  markedById   String?
  markedAt     DateTime         @default(now())

  lesson     Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  membership GroupMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([lessonId, membershipId])
}

model Grade {
  lessonId     String
  membershipId String
  score        Decimal  @db.Decimal(6, 2)
  comment      String?
  gradedById   String?
  gradedAt     DateTime @default(now())

  lesson     Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  membership GroupMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([lessonId, membershipId])
}

/// What kind of thing a lesson material is (A-105).
enum MaterialKind {
  FILE
  LINK
  RECORDING
}

/// A file, link or call recording students may open from their personal link
/// (added 2026-10-06, A-105). Tied to a lesson when one fits, else to the group.
model LessonMaterial {
  id          String       @id @default(cuid())
  groupId     String
  lessonId    String?
  kind        MaterialKind
  title       String
  /// `/api/v1/files/<key>` for uploads and recordings, any https URL for links.
  url         String
  size        Int?
  /// Recordings: length in seconds, as the browser measured it.
  durationSec Int?
  createdById String?
  createdAt   DateTime     @default(now())

  group     Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  lesson    Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  createdBy User?   @relation("materialAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([groupId, createdAt])
  @@index([lessonId])
}

/// Homework for one lesson (added 2026-10-06, A-102). The student answers
/// through their personal link; the teacher accepts or returns the answer.
model Homework {
  id            String    @id @default(cuid())
  lessonId      String    @unique
  groupId       String
  text          String
  linkUrl       String?
  attachmentUrl String?
  dueDate       DateTime? @db.Date
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  lesson      Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  group       Group                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy   User?                @relation("homeworkAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  submissions HomeworkSubmission[]

  @@index([groupId])
}

enum HomeworkStatus {
  SUBMITTED
  ACCEPTED
  RETURNED
}

model HomeworkSubmission {
  id             String         @id @default(cuid())
  homeworkId     String
  membershipId   String
  status         HomeworkStatus @default(SUBMITTED)
  note           String?
  attachmentUrl  String?
  submittedAt    DateTime       @default(now())
  checkedById    String?
  checkedAt      DateTime?
  teacherComment String?

  homework   Homework        @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  membership GroupMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  checkedBy  User?           @relation("homeworkChecker", fields: [checkedById], references: [id], onDelete: SetNull)

  @@unique([homeworkId, membershipId])
  @@index([membershipId])
}

model GroupNote {
  id        String   @id @default(cuid())
  groupId   String
  authorId  String?
  text      String
  createdAt DateTime @default(now())

  group  Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([groupId, createdAt])
}

// ---------------------------------------------------------------------------
// Phase 6: students, payments, discounts, receipts (EXP §6, §5 "To'lov",
// §5 CHEGIRMALAR / O'QUVCHIGA IZOH, §8 Chek sozlamalari, §11 TO'LOV)
// ---------------------------------------------------------------------------

/// "Manba" on the student and lead forms. Managed on the lead sources page (Phase 7).
model LeadSource {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  students     Student[]
  leads        Lead[]
  forms        LeadForm[]

  @@unique([organizationId, name])
}

/// "Ota-onasi" tab: name and phone, bulk SMS arrives in Phase 11.
model Parent {
  id        String   @id @default(cuid())
  studentId String
  fullName  String
  phone     String
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

/// "O'quvchiga qo'shimcha ma'lumot qo'shish": a named value on the profile card.
model StudentCustomField {
  id        String   @id @default(cuid())
  studentId String
  name      String
  value     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, name])
}

/// "Izoh va eslatmalar" on the student, also listed per group ("O'quvchiga izoh").
model StudentComment {
  id          String   @id @default(cuid())
  studentId   String
  groupId     String?
  text        String
  createdById String?
  createdAt   DateTime @default(now())

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group     Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
  @@index([groupId, createdAt])
}

/// "Chegirma": a reduced monthly price for the next `months` charges (A-10).
/// Remaining months = months − charges that used this discount.
model Discount {
  id              String   @id @default(cuid())
  membershipId    String
  discountedPrice Decimal  @db.Decimal(15, 2)
  amount          Decimal  @db.Decimal(15, 2) // course price − discounted price
  months          Int
  givenAt         DateTime @db.Date
  comment         String?
  createdById     String?
  /// Set when the discount comes from the family discount (A-123); replaced when the percent changes.
  familyId        String?
  createdAt       DateTime @default(now())

  membership GroupMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  createdBy  User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  family     Family?         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  charges    Charge[]

  @@index([membershipId])
  @@index([familyId])
}

/// One monthly fee per membership and course month (A-10). `month` is the first
/// day of the month; the amount is pro-rated by the lessons the student is in.
model Charge {
  id             String   @id @default(cuid())
  membershipId   String
  month          DateTime @db.Date
  price          Decimal  @db.Decimal(15, 2) // monthly price used (course, custom or discounted)
  amount         Decimal  @db.Decimal(15, 2)
  lessonsTotal   Int
  lessonsCounted Int
  discountId     String?
  createdAt      DateTime @default(now())

  membership GroupMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  discount   Discount?       @relation(fields: [discountId], references: [id], onDelete: SetNull)

  @@unique([membershipId, month])
}

/// "To'lov" (EXP §5 payment form, §6 payment history, §11 TO'LOV).
model Payment {
  id              String   @id @default(cuid())
  studentId       String
  membershipId    String
  branchId        String
  paymentMethodId String?
  amount          Decimal  @db.Decimal(15, 2)
  bonus           Decimal  @default(0) @db.Decimal(15, 2) // "O'quvchiga bonus"
  /// "Tasir vaqti": the course month this payment is for (first day of the month).
  effectiveMonth  DateTime @db.Date
  paidAt          DateTime @db.Date
  comment         String?
  receivedById    String?
  /// Set on the bonus-only payment the referral programme gives the referrer (A-120):
  /// the friend whose joining it rewards.
  referralOfId    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  student       Student         @relation(fields: [studentId], references: [id])
  membership    GroupMembership @relation(fields: [membershipId], references: [id])
  branch        Branch          @relation(fields: [branchId], references: [id])
  paymentMethod PaymentMethod?  @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  receivedBy    User?           @relation(fields: [receivedById], references: [id], onDelete: SetNull)
  refunds       Refund[]
  onlinePayment OnlinePayment?

  @@index([studentId, paidAt])
  @@index([membershipId])
  @@index([branchId, paidAt])
  @@index([effectiveMonth])
  @@index([referralOfId])
}

enum OnlinePaymentProvider {
  PAYME
  CLICK
}

enum OnlinePaymentStatus {
  PENDING
  PAID
  CANCELLED
}

/// A student's own payment through Payme or Click from their personal link
/// (A-106). The row's id is the order id the provider carries; when the
/// provider confirms, a regular Payment is written and linked here.
model OnlinePayment {
  id             String                @id @default(cuid())
  provider       OnlinePaymentProvider
  studentId      String
  membershipId   String
  branchId       String
  amount         Decimal               @db.Decimal(15, 2)
  effectiveMonth DateTime              @db.Date
  status         OnlinePaymentStatus   @default(PENDING)
  /// The provider's transaction id (Payme `id`, Click `click_trans_id`).
  externalId     String?
  /// Payme: 1 created, 2 performed, -1/-2 cancelled; Click: 0 prepared, 1 completed.
  externalState  Int?
  /// Payme's create_time (ms since epoch), echoed back in CheckTransaction.
  externalTime   BigInt?
  performedAt    DateTime?
  cancelledAt    DateTime?
  cancelReason   Int?
  paymentId      String?               @unique
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  student    Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  membership GroupMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  payment    Payment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, externalId])
  @@index([membershipId, status])
}

/// "Pul qaytarish": part or all of one payment given back.
model Refund {
  id           String   @id @default(cuid())
  paymentId    String
  amount       Decimal  @db.Decimal(15, 2)
  reason       String?
  refundedById String?
  createdAt    DateTime @default(now())

  payment    Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  refundedBy User?   @relation(fields: [refundedById], references: [id], onDelete: SetNull)

  @@index([paymentId])
}

/// Why a membership's balance was changed by hand (A-109).
enum BalanceAdjustmentKind {
  OPENING
  CORRECTION
}

/// A signed amount added to a membership's balance beside payments and charges (A-109):
/// the debt or credit a student brought over from the centre's previous system, or a correction.
model BalanceAdjustment {
  id           String                @id @default(cuid())
  membershipId String
  studentId    String
  branchId     String
  /// Positive = the student has money, negative = the student owes.
  amount       Decimal               @db.Decimal(15, 2)
  kind         BalanceAdjustmentKind @default(OPENING)
  date         DateTime              @db.Date
  comment      String?
  createdById  String?
  createdAt    DateTime              @default(now())

  membership GroupMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  student    Student         @relation(fields: [studentId], references: [id])
  branch     Branch          @relation(fields: [branchId], references: [id])
  createdBy  User?           @relation("adjustmentAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([membershipId])
  @@index([studentId])
  @@index([branchId, date])
}

// ---------------------------------------------------------------------------
// Debt collection (A-112): one case per student and branch while the student's
// memberships there owe money in total. Opened and closed by the balance engine,
// worked by staff (calls, promises) and by the daily cadence.
// ---------------------------------------------------------------------------

enum DebtCaseStatus {
  OPEN
  /// The student promised to pay by `promisedAt`; reminders pause until then.
  PROMISED
  CLOSED
}

enum DebtCloseReason {
  PAID
  PROMISE_KEPT
  /// The student was archived while still owing.
  LEFT
}

enum DebtContactChannel {
  CALL
  TELEGRAM
  SMS
  VISIT
  NOTE
}

enum DebtContactOutcome {
  NO_ANSWER
  PROMISED
  REFUSED
  WRONG_NUMBER
  OTHER
  /// System rows: the promised amount arrived, or the promised day passed with the debt still open.
  PROMISE_KEPT
  PROMISE_BROKEN
}

model DebtCase {
  id              String              @id @default(cuid())
  studentId       String
  branchId        String
  status          DebtCaseStatus      @default(OPEN)
  /// First day the student's balance in this branch was short (the first unpaid month).
  openedAt        DateTime            @db.Date
  /// Current debt as a positive amount, refreshed whenever balances are read.
  amount          Decimal             @db.Decimal(15, 2)
  promisedAt      DateTime?           @db.Date
  promisedAmount  Decimal?            @db.Decimal(15, 2)
  /// The debt when the promise was made, to tell a kept promise from a broken one.
  amountAtPromise Decimal?            @db.Decimal(15, 2)
  brokenPromises  Int                 @default(0)
  lastContactAt   DateTime?
  lastChannel     DebtContactChannel?
  lastOutcome     DebtContactOutcome?
  /// Cadence steps already taken for this case.
  telegramAt      DateTime?
  smsAt           DateTime?
  taskAt          DateTime?
  closedAt        DateTime?
  closedReason    DebtCloseReason?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  student  Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  branch   Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  contacts DebtContact[]

  @@index([branchId, status, openedAt])
  @@index([studentId, status])
}

model DebtContact {
  id             String              @id @default(cuid())
  caseId         String
  channel        DebtContactChannel
  outcome        DebtContactOutcome?
  promisedAt     DateTime?           @db.Date
  promisedAmount Decimal?            @db.Decimal(15, 2)
  note           String?
  /// True for rows the cadence or the promise check wrote, false for staff entries.
  auto           Boolean             @default(false)
  createdById    String?
  createdAt      DateTime            @default(now())

  case      DebtCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("debtContactAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([caseId, createdAt])
}

/**
 * Absence follow-up (A-125). A case follows one student in one group from the
 * day they stop coming until they are back or gone: STREAK = the last marked
 * lessons are absences in a row, SILENT = not one present mark for a number of
 * days although the group met.
 */
enum AbsenceReason {
  STREAK
  SILENT
}

enum AbsenceCaseStatus {
  OPEN
  CLOSED
}

enum AbsenceCloseReason {
  RETURNED
  LEFT
  CLEARED
}

enum AbsenceContactOutcome {
  NO_ANSWER
  WILL_RETURN
  ILL
  LEAVING
  OTHER
}

model AbsenceCase {
  id            String                 @id @default(cuid())
  membershipId  String
  studentId     String
  groupId       String
  branchId      String
  status        AbsenceCaseStatus      @default(OPEN)
  reason        AbsenceReason
  /// Lessons missed in a row (STREAK) or held without a present mark (SILENT), refreshed while open.
  missed        Int                    @default(0)
  /// The first lesson of the run the student missed.
  sinceAt       DateTime               @db.Date
  /// The last lesson the student was marked present at, when there is one.
  lastPresentAt DateTime?              @db.Date
  openedAt      DateTime               @db.Date
  lastContactAt DateTime?
  lastChannel   DebtContactChannel?
  lastOutcome   AbsenceContactOutcome?
  closedAt      DateTime?
  closedReason  AbsenceCloseReason?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  membership GroupMembership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group      Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  branch     Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  contacts   AbsenceContact[]

  @@index([branchId, status, sinceAt])
  @@index([membershipId, status])
  @@index([studentId])
}

/// A call, visit, message or note on an absence case; the channel list is shared with debts.
model AbsenceContact {
  id          String                 @id @default(cuid())
  caseId      String
  channel     DebtContactChannel
  outcome     AbsenceContactOutcome?
  note        String?
  createdById String?
  createdAt   DateTime               @default(now())

  case      AbsenceCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdBy User?       @relation("absenceContactAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([caseId, createdAt])
}

enum ReceiptLogoPosition {
  TOP
  BOTTOM
}

/// "Chek sozlamalari" (EXP §8): what the printed receipt shows.
model ReceiptSettings {
  id             String              @id @default(cuid())
  organizationId String              @unique
  address        String?
  phone          String?
  visibleFields  String[]            @default([])
  logoPosition   ReceiptLogoPosition @default(TOP)
  footerText     String?
  updatedAt      DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Phase 7: leads (EXP §2 Kanban, §3 sources, §8 Forms)
// ---------------------------------------------------------------------------

enum LeadStatus {
  NEW
  CONTACTED
  UNREACHABLE
  LOST
}

enum LeadTemperature {
  HOT
  WARM
  COLD
}

/// How a call or visit to a lead ended (A-126).
enum LeadContactOutcome {
  NO_ANSWER
  WILL_COME
  THINKING
  NOT_INTERESTED
  WRONG_NUMBER
  OTHER
}

/// "Kunni tanlang" on the lead form: odd days, even days or "other days".
enum LeadDays {
  ODD
  EVEN
  OTHER
}

/// A pipeline ("Website" in the board selector). Boards belong to a branch (A-66).
model LeadBoard {
  id        String   @id @default(cuid())
  branchId  String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch  Branch       @relation(fields: [branchId], references: [id])
  columns LeadColumn[]
  leads   Lead[]

  @@unique([branchId, name])
}

/// "Bo'lim": a Kanban column (stage) of a board.
model LeadColumn {
  id        String   @id @default(cuid())
  boardId   String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board LeadBoard  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  leads Lead[]
  forms LeadForm[]

  @@unique([boardId, name])
  @@index([boardId, sortOrder])
}

/// "Yangi Lid" (EXP §2 form). Phones live in LeadPhone ("+ Telefon raqam qo'shish").
model Lead {
  id            String              @id @default(cuid())
  branchId      String
  boardId       String
  columnId      String
  fullName      String
  birthDate     DateTime?           @db.Date
  age           Int?
  sourceId      String?
  teacherId     String?
  days          LeadDays?
  lessonTime    String? // "HH:mm"
  status        LeadStatus          @default(NEW)
  temperature   LeadTemperature?
  comment       String?
  sortOrder     Int                 @default(0)
  isArchived    Boolean             @default(false)
  /// Set when the lead was added to a group (converted) or came back from a group.
  studentId     String?
  convertedAt   DateTime?
  formId        String?
  createdById   String?
  /// The deal in amoCRM this lead mirrors (A-115): set when amoCRM posted it or
  /// when Kampus pushed it there, so neither side imports it twice.
  amoCrmLeadId  String?
  /// The student whose invite brought this lead (A-120); credited when the lead joins a group.
  referrerId    String?
  /// Follow-up (A-126): who works the lead, when to contact them next and how the last contact ended.
  ownerId       String?
  nextContactAt DateTime?           @db.Date
  lastContactAt DateTime?
  lastOutcome   LeadContactOutcome?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  owner     User?         @relation("leadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contacts  LeadContact[]
  branch    Branch        @relation(fields: [branchId], references: [id])
  board     LeadBoard     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  column    LeadColumn    @relation(fields: [columnId], references: [id])
  source    LeadSource?   @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  teacher   User?         @relation("leadTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  student   Student?      @relation(fields: [studentId], references: [id], onDelete: SetNull)
  form      LeadForm?     @relation(fields: [formId], references: [id], onDelete: SetNull)
  createdBy User?         @relation("leadCreator", fields: [createdById], references: [id], onDelete: SetNull)
  referrer  Student?      @relation("leadReferrer", fields: [referrerId], references: [id], onDelete: SetNull)
  phones    LeadPhone[]
  school    School?       @relation(fields: [schoolId], references: [id])
  schoolId  String?

  @@index([columnId, isArchived, sortOrder])
  @@index([referrerId])
  @@index([branchId, isArchived])
  @@index([sourceId, createdAt])
  @@index([studentId])
  @@index([amoCrmLeadId])
  @@index([ownerId, nextContactAt])
  @@index([branchId, nextContactAt])
}

/// One call, message, visit or note on a lead (A-126), with the next date agreed.
model LeadContact {
  id            String              @id @default(cuid())
  leadId        String
  channel       DebtContactChannel
  outcome       LeadContactOutcome?
  note          String?
  /// The next-contact date set together with this contact, if any.
  nextContactAt DateTime?           @db.Date
  createdById   String?
  createdAt     DateTime            @default(now())

  lead      Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy User? @relation("leadContactAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
}

model LeadPhone {
  id        String @id @default(cuid())
  leadId    String
  phone     String
  sortOrder Int    @default(0)

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([phone])
}

/// "Formalar" (EXP §8): a public lead-capture form that drops into one column.
model LeadForm {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String   @unique
  columnId       String
  sourceId       String?
  /// Free text shown in the "Integratsiya" column (the reference's values were not visible).
  integration    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  column       LeadColumn    @relation(fields: [columnId], references: [id])
  source       LeadSource?   @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  leads        Lead[]
  publicPageOf OrgSettings[]
  school       School?       @relation(fields: [schoolId], references: [id])
  schoolId     String?

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Phase 8: exams (EXP §7, §5 IMTIHON tab, §6 progress tab)
// ---------------------------------------------------------------------------

enum ExamType {
  GROUP
  MOCK
}

enum ExamStatus {
  NOT_STARTED
  FINISHED
}

/// "Imtihon": a group exam (one group) or a mock exam (several target groups, price, capacity).
model Exam {
  id              String     @id @default(cuid())
  branchId        String
  type            ExamType
  name            String
  groupId         String?
  isRetake        Boolean    @default(false)
  date            DateTime   @db.Date
  startTime       String // "HH:mm"
  endTime         String
  examinerId      String?
  roomId          String?
  /// null = "Maxsus" (custom): only pass and max scores, no level names.
  gradingSystemId String?
  passScore       Decimal    @db.Decimal(6, 2)
  maxScore        Decimal    @db.Decimal(6, 2)
  price           Decimal?   @db.Decimal(15, 2)
  capacity        Int?
  status          ExamStatus @default(NOT_STARTED)
  finishedAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  branch        Branch         @relation(fields: [branchId], references: [id])
  group         Group?         @relation(fields: [groupId], references: [id], onDelete: SetNull)
  examiner      User?          @relation("examiner", fields: [examinerId], references: [id], onDelete: SetNull)
  room          Room?          @relation(fields: [roomId], references: [id], onDelete: SetNull)
  gradingSystem GradingSystem? @relation(fields: [gradingSystemId], references: [id], onDelete: SetNull)
  targets       ExamGroup[]
  results       ExamResult[]

  @@index([branchId, type, status, date])
  @@index([groupId])
}

/// Target groups of a mock exam ("Tanlangan guruhlar").
model ExamGroup {
  examId  String
  groupId String

  exam  Exam  @relation(fields: [examId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([examId, groupId])
  @@index([groupId])
}

/// One row per student: a registration ("Ariza") until a score is entered.
model ExamResult {
  id           String    @id @default(cuid())
  examId       String
  studentId    String
  score        Decimal?  @db.Decimal(6, 2)
  isPresent    Boolean   @default(true)
  comment      String?
  registeredAt DateTime  @default(now())
  gradedById   String?
  gradedAt     DateTime?

  exam     Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  student  Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gradedBy User?   @relation("examGrader", fields: [gradedById], references: [id], onDelete: SetNull)

  @@unique([examId, studentId])
  @@index([studentId])
}

/**
 * Phase 9: finance (EXP §9).
 */

/// "Chiqim hisoboti" / "Kirim hisoboti" categories ("+ BO'LIM").
enum FinanceKind {
  EXPENSE
  INCOME
}

model FinanceCategory {
  id             String      @id @default(cuid())
  organizationId String
  kind           FinanceKind
  name           String
  sortOrder      Int         @default(0)
  createdAt      DateTime    @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entries      FinanceEntry[]

  @@unique([organizationId, kind, name])
}

/// One ledger for every money row of EXP §9: category expenses and incomes,
/// advances, marketing, staff bonuses and fines, investments (A-74).
enum FinanceEntryType {
  EXPENSE
  INCOME
  ADVANCE
  MARKETING
  BONUS
  PENALTY
  INVESTMENT
}

model FinanceEntry {
  id              String           @id @default(cuid())
  branchId        String
  type            FinanceEntryType
  categoryId      String?
  paymentMethodId String?
  amount          Decimal          @db.Decimal(15, 2)
  date            DateTime         @db.Date
  comment         String?
  /// "XODIM / TALABA" counterparty; advances, bonuses and fines always name a staff member.
  staffId         String?
  studentId       String?
  /// Investments: "Ism familiya" of the investor.
  counterparty    String?
  createdById     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  branch        Branch           @relation(fields: [branchId], references: [id])
  category      FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod?   @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  staff         User?            @relation("financeStaff", fields: [staffId], references: [id], onDelete: SetNull)
  student       Student?         @relation(fields: [studentId], references: [id], onDelete: SetNull)
  createdBy     User?            @relation("financeCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([branchId, type, date])
  @@index([staffId, date])
}

/// "Ish haqi hisobotlari": one computed run per month (A-75).
enum PayrollStatus {
  DRAFT
  SAVED
}

enum PayrollLineStatus {
  MODERATION
  APPROVED
}

model PayrollRun {
  id             String        @id @default(cuid())
  organizationId String
  month          DateTime      @db.Date
  status         PayrollStatus @default(DRAFT)
  computedAt     DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines        PayrollLine[]

  @@unique([organizationId, month])
}

model PayrollLine {
  id           String            @id @default(cuid())
  runId        String
  userId       String
  roleName     String
  fixed        Decimal           @default(0) @db.Decimal(15, 2)
  percent      Decimal           @default(0) @db.Decimal(15, 2)
  perLesson    Decimal           @default(0) @db.Decimal(15, 2)
  perStudent   Decimal           @default(0) @db.Decimal(15, 2)
  bonus        Decimal           @default(0) @db.Decimal(15, 2)
  penalty      Decimal           @default(0) @db.Decimal(15, 2)
  penaltyCount Int               @default(0)
  advance      Decimal           @default(0) @db.Decimal(15, 2)
  net          Decimal           @default(0) @db.Decimal(15, 2)
  /// Per-group breakdown shown on hover / in the row details.
  details      Json              @default("[]")
  status       PayrollLineStatus @default(MODERATION)
  approvedById String?
  approvedAt   DateTime?

  run        PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id])
  approvedBy User?      @relation("payrollApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([runId, userId])
}

// ---------------------------------------------------------------------------
// Phase 10: coins and marketplace (EXP §5 COINLAR, §8 Coin sozlamalari,
// §10 Coins report), tests and question bank (EXP §5 TEST / BILIM TAHLILI,
// §6 TEST NATIJALARI, §8 Test sozlamalari). See ASSUMPTIONS A-78..A-82.
// ---------------------------------------------------------------------------

/// "Avtomatik coin qoidalari": one row per event, seeded with the reference's amounts.
enum CoinEvent {
  ATTENDANCE
  HOMEWORK
  TEST_RESULT
  BIRTHDAY
  /// A friend brought by the student joined a group (A-120).
  REFERRAL
}

model CoinRule {
  id             String    @id @default(cuid())
  organizationId String
  event          CoinEvent
  amount         Int
  isActive       Boolean   @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, event])
}

/// "Qo'lda beriladigan coin sabablari": a reason with the cap a teacher may give.
model CoinReason {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  maxCoins       Int
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions CoinTransaction[]

  @@unique([organizationId, name])
}

enum CoinTransactionKind {
  MANUAL
  AUTO
  PURCHASE
}

/// Every coin movement. Positive = earned, negative = spent (A-78).
model CoinTransaction {
  id        String              @id @default(cuid())
  studentId String
  groupId   String?
  kind      CoinTransactionKind
  amount    Int
  reasonId  String?
  event     CoinEvent?
  /// Idempotency key for automatic awards, e.g. `attendance:<lessonId>:<membershipId>`.
  refKey    String?             @unique
  comment   String?
  givenById String?
  createdAt DateTime            @default(now())

  student  Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group    Group?           @relation(fields: [groupId], references: [id], onDelete: SetNull)
  reason   CoinReason?      @relation(fields: [reasonId], references: [id], onDelete: SetNull)
  givenBy  User?            @relation("coinGiver", fields: [givenById], references: [id], onDelete: SetNull)
  purchase PurchaseRequest?

  @@index([studentId, createdAt])
  @@index([groupId])
}

model ProductCategory {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([organizationId, name])
}

/// Marketplace item ("Yangi mahsulot": image, name, category, price in coins, stock, active).
model Product {
  id             String   @id @default(cuid())
  organizationId String
  categoryId     String
  name           String
  imageUrl       String?
  priceCoins     Int
  stock          Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     ProductCategory   @relation(fields: [categoryId], references: [id])
  requests     PurchaseRequest[]

  @@index([organizationId, isActive])
  @@index([categoryId])
}

enum PurchaseStatus {
  PENDING
  APPROVED
  REJECTED
}

/// "Xarid so'rovlari": a student's request to buy a product with coins (A-80).
model PurchaseRequest {
  id            String         @id @default(cuid())
  studentId     String
  productId     String
  coins         Int
  status        PurchaseStatus @default(PENDING)
  createdById   String?
  decidedById   String?
  decidedAt     DateTime?
  transactionId String?        @unique
  createdAt     DateTime       @default(now())

  student     Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  product     Product          @relation(fields: [productId], references: [id])
  createdBy   User?            @relation("purchaseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  decidedBy   User?            @relation("purchaseDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  transaction CoinTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([studentId])
}

/// Question bank item: one multiple-choice question under a subject and topic (A-81).
model QuestionBankItem {
  id             String   @id @default(cuid())
  organizationId String
  subject        String
  topic          String
  text           String
  /// Answer options in order; `correctIndex` points into this list.
  options        Json
  correctIndex   Int
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?          @relation("questionAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  usages       TestQuestion[]

  @@index([organizationId, subject, topic])
}

enum TestStatus {
  DRAFT
  ACTIVE
  CLOSED
}

/// A test built from question-bank items and assigned to groups (A-81).
model Test {
  id               String     @id @default(cuid())
  organizationId   String
  name             String
  subject          String
  timeLimitMinutes Int?
  passPercent      Int        @default(60)
  deadline         DateTime?  @db.Date
  status           TestStatus @default(DRAFT)
  createdById      String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?          @relation("testAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  questions    TestQuestion[]
  groups       TestGroup[]
  attempts     TestAttempt[]

  @@index([organizationId, status])
}

model TestQuestion {
  id         String @id @default(cuid())
  testId     String
  questionId String
  points     Int    @default(1)
  sortOrder  Int    @default(0)

  test     Test             @relation(fields: [testId], references: [id], onDelete: Cascade)
  question QuestionBankItem @relation(fields: [questionId], references: [id])

  @@unique([testId, questionId])
}

/// "Guruhga test berish": the groups a test is assigned to.
model TestGroup {
  testId  String
  groupId String

  test  Test  @relation(fields: [testId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([testId, groupId])
  @@index([groupId])
}

/// One submitted test by one student; answers are entered by staff in v1 (A-82).
model TestAttempt {
  id              String   @id @default(cuid())
  testId          String
  studentId       String
  groupId         String?
  /// `{ [questionId]: chosenIndex }`; a missing key means unanswered.
  answers         Json
  score           Int
  maxScore        Int
  percent         Decimal  @db.Decimal(5, 2)
  durationSeconds Int?
  submittedAt     DateTime @default(now())
  enteredById     String?

  test      Test    @relation(fields: [testId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group     Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  enteredBy User?   @relation("attemptEnteredBy", fields: [enteredById], references: [id], onDelete: SetNull)

  @@index([testId, studentId])
  @@index([studentId, submittedAt])
  @@index([groupId])
}

// ---------------------------------------------------------------------------
// Phase 11: SMS (EXP §8 SMS shablonlari, Auto SMS, SMS log), calls, Telegram bot
// recipients, integration settings, staff attendance (FaceID) and the job queue.
// ---------------------------------------------------------------------------

/// "Kategoriya" of SMS templates (EXP §8 SMS shablonlari).
model SmsCategory {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  templates    SmsTemplate[]

  @@unique([organizationId, name])
}

model SmsTemplate {
  id             String   @id @default(cuid())
  organizationId String
  categoryId     String
  text           String
  /// Set when the text came from "Eskizdan import qilish" (A-84).
  providerId     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     SmsCategory  @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
}

/// The ten "AUTO SMS SOZLAMALARI" switches (EXP §8 General settings).
enum AutoSmsEvent {
  BIRTHDAY
  EXAM_RESULT
  PAYMENT_MADE
  ABSENT
  PRESENT
  PAYMENT_DUE_SOON
  DEBTOR
  GRADES
  DAY_BEFORE_FIRST_LESSON
  ADDED_TO_GROUP
  LESSON_CANCELLED
  LESSON_MOVED
  LESSON_RESTORED
  INSTALMENT_DUE
}

model AutoSmsSetting {
  id             String       @id @default(cuid())
  organizationId String
  event          AutoSmsEvent
  isActive       Boolean      @default(false)
  template       String
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, event])
}

enum SmsRecipientType {
  STUDENT
  PARENT
  STAFF
  LEAD
  OTHER
}

enum SmsStatus {
  QUEUED
  SENT
  FAILED
}

/// One SMS to one phone (EXP §8 SMS log: Qabul qildi, Xabar, Yubordi, Yuborilgan vaqti).
model SmsMessage {
  id             String           @id @default(cuid())
  organizationId String
  branchId       String?
  recipientType  SmsRecipientType
  recipientName  String
  phone          String
  /// The student the message is about (also for parent messages), for the student's SMS tab.
  studentId      String?
  text           String
  status         SmsStatus        @default(QUEUED)
  /// Null = "Dastur tomonidan jo'natildi" (sent by the system).
  sentById       String?
  event          AutoSmsEvent?
  providerId     String?
  error          String?
  /// One automatic message per event and subject (e.g. `absent:<lessonId>:<membershipId>`).
  refKey         String?          @unique
  createdAt      DateTime         @default(now())
  sentAt         DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  student      Student?     @relation(fields: [studentId], references: [id], onDelete: SetNull)
  sentBy       User?        @relation("smsSender", fields: [sentById], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([studentId, createdAt])
  @@index([status])
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallStatus {
  ANSWERED
  MISSED
  BUSY
  FAILED
}

/// "Qo'ng'iroqlar" (EXP §8 Calls): rows come from the telephony webhook or a click-to-call (A-86).
model CallLog {
  id              String        @id @default(cuid())
  organizationId  String
  branchId        String?
  direction       CallDirection
  status          CallStatus
  fromPhone       String
  toPhone         String
  staffId         String?
  studentId       String?
  durationSeconds Int           @default(0)
  recordingUrl    String?
  externalId      String?       @unique
  startedAt       DateTime
  createdAt       DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  staff        User?        @relation("callStaff", fields: [staffId], references: [id], onDelete: SetNull)
  student      Student?     @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([organizationId, startedAt])
  @@index([studentId, startedAt])
}

/// "Bot xabarnoma" (EXP §8): a staff member who gets Telegram notifications (Mahsus ID = chat id).
model BotRecipient {
  id             String   @id @default(cuid())
  organizationId String
  userId         String   @unique
  chatId         String
  /// Branches whose events this person hears about; empty = all branches.
  branchIds      String[] @default([])
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

enum IntegrationProvider {
  SMS
  TELEGRAM
  AMOCRM
  TELEPHONY
  FACE_ID
  VIDEO
  PAYME
  CLICK
}

/// One row per provider: enabled flag plus its settings (A-83). Secrets are masked in the API.
model IntegrationSetting {
  id             String              @id @default(cuid())
  organizationId String
  provider       IntegrationProvider
  isEnabled      Boolean             @default(false)
  config         Json
  updatedAt      DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
}

enum CheckSource {
  FACE_ID
  MANUAL
}

/// One staff member's check-in/out on one day (EXP §10 Hodimlar davomati). A-87.
model StaffAttendance {
  id       String      @id @default(cuid())
  userId   String
  branchId String
  date     DateTime    @db.Date
  checkIn  DateTime?
  checkOut DateTime?
  source   CheckSource @default(FACE_ID)
  deviceId String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([userId, date])
  @@index([branchId, date])
}

/// "Ish jadvallari": expected hours per weekday (0 = Sunday … 6 = Saturday); no row = day off.
model WorkSchedule {
  id      String @id @default(cuid())
  userId  String
  weekday Int
  start   String // HH:mm
  end     String // HH:mm

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekday])
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

/// Postgres-backed job queue (A-21): auto-SMS, Telegram notifications, daily scans.
model Job {
  id        String    @id @default(cuid())
  type      String
  payload   Json
  status    JobStatus @default(PENDING)
  runAt     DateTime  @default(now())
  attempts  Int       @default(0)
  lastError String?
  /// Prevents duplicates, e.g. `daily:2026-10-04`.
  uniqueKey String?   @unique
  lockedAt  DateTime?
  createdAt DateTime  @default(now())
  doneAt    DateTime?

  @@index([status, runAt])
}

/// Phase 12: reasons offered when a student leaves or changes group ("SABABLARNI SOZLASH").
enum LeaveReasonKind {
  LEAVE
  TRANSFER
}

model LeaveReason {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  kind           LeaveReasonKind
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, kind, name])
}

/// Phase 12: outcomes behind the graduates report cards (IELTS, CEFR, university, employment).
model GraduateRecord {
  id           String          @id @default(cuid())
  membershipId String          @unique
  ieltsScore   Decimal?        @db.Decimal(3, 1)
  cefrLevel    String?
  university   Boolean?
  employed     Boolean?
  note         String?
  updatedAt    DateTime        @updatedAt
  membership   GroupMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
}

/// Header bell (EXP §11 "Xabarnomalar", A-97): one row per recipient; the text is
/// rendered client-side from `kind` and `params` in the viewer's language.
enum NotificationKind {
  PAYMENT
  LEAD
  DEBTORS
  BIRTHDAY
  DEBT_TASK
  DEBT_PROMISE_BROKEN
  ABSENCES
  LEAD_FOLLOW_UP
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  kind      NotificationKind
  params    Json
  href      String?
  branchId  String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

// ---------------------------------------------------------------------------
// Video lessons: browser-to-browser (WebRTC) calls tied to a group's lessons.
// The server only relays connection messages; audio and video never pass through it.
// ---------------------------------------------------------------------------

enum VideoRoomStatus {
  LIVE
  ENDED
}

enum VideoPeerRole {
  HOST
  STAFF
  STUDENT
}

/// One video lesson of a group. At most one LIVE room per group (checked in the service).
model VideoRoom {
  id          String          @id @default(cuid())
  groupId     String
  lessonId    String?
  status      VideoRoomStatus @default(LIVE)
  startedById String
  startedAt   DateTime        @default(now())
  endedAt     DateTime?

  group        Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  lesson       Lesson?            @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  startedBy    User               @relation("videoRoomStarter", fields: [startedById], references: [id])
  participants VideoParticipant[]
  signals      VideoSignal[]

  @@index([groupId, status])
  @@index([lessonId])
}

/// One browser in a room. Its id is the peer id other browsers address; the
/// secret (stored hashed) proves the browser owns it.
model VideoParticipant {
  id          String        @id @default(cuid())
  roomId      String
  role        VideoPeerRole
  userId      String?
  studentId   String?
  displayName String
  secretHash  String
  /// Last reported { audio, video, screen } switches, for the icons others see.
  media       Json?
  joinedAt    DateTime      @default(now())
  lastSeenAt  DateTime      @default(now())
  leftAt      DateTime?

  room    VideoRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user    User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  student Student?  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([roomId, lastSeenAt])
  @@index([userId])
  @@index([studentId])
}

/// Offer, answer or ICE candidate from one browser to another; deleted once read.
model VideoSignal {
  id        Int      @id @default(autoincrement())
  roomId    String
  fromId    String
  toId      String
  kind      String
  payload   Json
  createdAt DateTime @default(now())

  room VideoRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, toId, id])
}

/// A cashier's day close (A-122): what one cashier recorded in one branch on one Tashkent
/// calendar day, by payment method, the cash the drawer should hold, the cash counted, and the
/// hand-over to whoever accepts it.
model CashClose {
  id             String    @id @default(cuid())
  organizationId String
  branchId       String
  cashierId      String
  date           DateTime  @db.Date
  /// Per payment method: payments, other income, refunds, expenses and the net, as computed when closing.
  totals         Json
  paymentsCount  Int       @default(0)
  expectedCash   Decimal   @db.Decimal(15, 2)
  countedCash    Decimal   @db.Decimal(15, 2)
  difference     Decimal   @db.Decimal(15, 2)
  note           String?
  acceptedById   String?
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  cashier      User         @relation("cashCloseCashier", fields: [cashierId], references: [id], onDelete: Cascade)
  acceptedBy   User?        @relation("cashCloseAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@unique([branchId, cashierId, date])
  @@index([organizationId, date])
}

/// Siblings studying at the centre (A-123): one link, one discount for all of them.
model Family {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  /// Percent off the monthly price of every member's groups; 0 keeps the link without a discount.
  discountPercent Int      @default(0)
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  students     Student[]
  discounts    Discount[]

  @@index([organizationId])
}

/// One part of a month's fee with its own due day (A-123). The parts of a month
/// schedule its charge; a part is a debt only once its day has passed.
model Instalment {
  id           String    @id @default(cuid())
  membershipId String
  month        DateTime  @db.Date
  dueDate      DateTime  @db.Date
  amount       Decimal   @db.Decimal(15, 2)
  /// When the student was reminded that this part is due soon.
  remindedAt   DateTime?
  createdById  String?
  createdAt    DateTime  @default(now())

  membership GroupMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  createdBy  User?           @relation("instalmentCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([membershipId, month])
  @@index([dueDate])
}
