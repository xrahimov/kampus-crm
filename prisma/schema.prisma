// Kampus CRM — Prisma schema.
// Phase 2 (skeleton): organisation, branches, users, roles, sessions, logs.
// Later phases add their own models in the sections marked below.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Organisation & branches (EXP §0 branch selector, §8 general settings)
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches        Branch[]
  settings        OrgSettings?
  paymentMethods  PaymentMethod[]
  gradingSystems  GradingSystem[]
  schools         School[]
  leadSources     LeadSource[]
  receiptSettings ReceiptSettings?
}

model Branch {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  users        UserBranch[]
  sessions     Session[]
  auditLogs    AuditLog[]
  courses      Course[]
  rooms        Room[]
  daysOff      DayOff[]
  groups       Group[]
  students     Student[]
  payments     Payment[]

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Users, roles, permissions (EXP §8 Staff, Roles)
// ---------------------------------------------------------------------------

enum Gender {
  MALE
  FEMALE
}

/// How a teacher is paid (EXP §4 "Maosh hisoblash usuli"); see A-12.
enum SalaryMethod {
  PERCENT
  MONTHLY
  PER_LESSON
  PER_STUDENT
}

model User {
  id            String        @id @default(cuid())
  fullName      String
  phone         String        @unique // E.164, e.g. +998901234567
  passwordHash  String
  gender        Gender        @default(MALE)
  birthDate     DateTime?     @db.Date
  hireDate      DateTime?     @db.Date
  photoUrl      String?
  salaryMethod  SalaryMethod?
  fixedSalary   Decimal?      @db.Decimal(15, 2) // MONTHLY: UZS per month
  percentShare  Decimal?      @db.Decimal(5, 2) // PERCENT: % of course price
  perLessonFee  Decimal?      @db.Decimal(15, 2) // PER_LESSON: UZS per lesson
  perStudentFee Decimal?      @db.Decimal(15, 2) // PER_STUDENT: UZS per active student
  isArchived    Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  roles     UserRole[]
  branches  UserBranch[]
  sessions  Session[]
  loginLogs LoginLog[]
  auditLogs AuditLog[]

  groupsTaught    GroupTeacher[]
  groupsSupported GroupSupportTeacher[] @relation("supportOf")
  groupNotes      GroupNote[]

  paymentsReceived Payment[]
  refundsMade      Refund[]
  discountsGiven   Discount[]
  studentComments  StudentComment[]
}

/// A role is a named bundle of permission codes. System roles are seeded and
/// cannot be deleted; the CEO can create custom roles (EXP §8 Roles (Beta)).
model Role {
  id          String   @id @default(cuid())
  code        String   @unique // e.g. CEO, ADMIN, TEACHER, or custom:branch-manager
  name        String
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  permissions String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users UserRole[]
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model UserBranch {
  userId   String
  branchId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@index([branchId])
}

// ---------------------------------------------------------------------------
// Auth: sessions, login rate limiting, login log (EXP §8 "Tizimga kirishlar")
// ---------------------------------------------------------------------------

model Session {
  id             String   @id @default(cuid())
  tokenHash      String   @unique // sha256 of the opaque cookie token
  userId         String
  activeBranchId String?
  csrfSecret     String
  ip             String?
  userAgent      String?
  expiresAt      DateTime
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeBranch Branch? @relation(fields: [activeBranchId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
}

/// One row per failed login, keyed by phone and by IP. Counted in a sliding
/// window to lock out brute force (see server/auth/rate-limit.ts).
model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model LoginLog {
  id        String   @id @default(cuid())
  userId    String?
  phone     String
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Audit log for every create/update/delete (EXP §5 group history,
// §6 student history, §8 action log)
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  branchId  String?
  action    String // e.g. group.update
  entity    String // e.g. Group
  entityId  String
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  actor  User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([entity, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Settings core (Phase 3, EXP §8 "Umumiy sozlamalar", Kurslar, Xonalar,
// Dam olish kunlari, Maktablar)
// ---------------------------------------------------------------------------

/// The switches on the "Markaz sozlamalari" tab, one row per organisation.
/// Each flag is read by the module it governs in a later phase.
model OrgSettings {
  id             String @id @default(cuid())
  organizationId String @unique

  spreadOverpayment          Boolean @default(false) // overpayment is spread over the next months
  adminActionsNeedApproval   Boolean @default(false) // admin actions wait for CEO approval (A-09)
  printReceiptAfterPayment   Boolean @default(false)
  refundsEnabled             Boolean @default(false)
  attendanceComments         Boolean @default(false)
  teachersSeeExamSchedule    Boolean @default(false)
  attendanceOnlyDuringLesson Boolean @default(false)
  teacherSeesSalary          Boolean @default(false)
  payTeacherOnGroupDayOff    Boolean @default(false)
  payOnlyAttendedLessons     Boolean @default(false)
  teacherCanAddStudents      Boolean @default(false)
  bookAnySupportTeacher      Boolean @default(false)
  groupSupportSessions       Boolean @default(false)

  workStart           String @default("08:00") // HH:mm, schedule grid start
  workEnd             String @default("20:00") // HH:mm, schedule grid end
  scheduleStepMinutes Int    @default(30) // 15 or 30

  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// "To'lov usullari" on the general settings tab. Payments reference these from Phase 6.
model PaymentMethod {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payments     Payment[]

  @@unique([organizationId, name])
}

enum RoundingType {
  STANDARD
  IELTS
}

/// "Baholash tizimlari": a named scale with ordered levels (A-16).
model GradingSystem {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  rounding       RoundingType @default(STANDARD)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  levels       GradingLevel[]
  courses      Course[]
  groups       Group[]

  @@unique([organizationId, name])
}

model GradingLevel {
  id              String  @id @default(cuid())
  gradingSystemId String
  name            String
  minScore        Decimal @db.Decimal(6, 2)
  maxScore        Decimal @db.Decimal(6, 2)
  sortOrder       Int     @default(0)

  gradingSystem GradingSystem @relation(fields: [gradingSystemId], references: [id], onDelete: Cascade)

  @@index([gradingSystemId, sortOrder])
}

/// "Kurslar": per branch, with a monthly price and duration in months.
model Course {
  id              String   @id @default(cuid())
  branchId        String
  name            String
  description     String?
  price           Decimal  @db.Decimal(15, 2) // UZS per month
  durationMonths  Int
  gradingSystemId String?
  color           String? // hex, e.g. #0F766E
  isArchived      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  branch        Branch         @relation(fields: [branchId], references: [id])
  gradingSystem GradingSystem? @relation(fields: [gradingSystemId], references: [id], onDelete: SetNull)
  groups        Group[]

  @@index([branchId, isArchived])
  @@index([gradingSystemId])
}

/// "Xonalar": per branch, with a seat capacity.
model Room {
  id        String   @id @default(cuid())
  branchId  String
  name      String
  capacity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch              @relation(fields: [branchId], references: [id])
  slots  GroupScheduleSlot[]

  @@unique([branchId, name])
}

/// "Dam olish kunlari": a date on which the branch holds no lessons.
model DayOff {
  id        String   @id @default(cuid())
  branchId  String
  date      DateTime @db.Date
  reason    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([branchId, date])
}

/// "Maktablar": the schools students attend (students reference them from Phase 6).
model School {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  students     Student[]

  @@unique([organizationId, name])
}

// --- Phase 5: groups, schedule, lessons, attendance (EXP §5) -----------------

enum GroupStatus {
  ACTIVE
  ARCHIVED
  TRIAL
  FROZEN
}

/// "Hafta kunlari": EVEN = Tue/Thu/Sat, ODD = Mon/Wed/Fri (A-50), EVERY_DAY = Mon–Sat, CUSTOM = chosen days.
enum WeekdayPattern {
  EVEN
  ODD
  EVERY_DAY
  CUSTOM
}

enum GroupTeacherRole {
  MAIN
  ASSISTANT
  CO_TEACHER
}

/// A teacher's share in one group ("Ulush turi", EXP §5); overrides the teacher's default (A-12).
enum ShareType {
  PERCENT
  PER_LESSON
  PER_STUDENT
}

enum MembershipStatus {
  NEW
  TRIAL
  ACTIVE
  FROZEN
  ARCHIVED
  GRADUATED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
  NOT_MARKED
}

model Group {
  id              String         @id @default(cuid())
  branchId        String
  courseId        String
  gradingSystemId String? // override; null = the course's system
  name            String
  weekdayPattern  WeekdayPattern @default(EVEN)
  startDate       DateTime       @db.Date
  endDate         DateTime       @db.Date
  status          GroupStatus    @default(ACTIVE)
  finishedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  branch          Branch                @relation(fields: [branchId], references: [id])
  course          Course                @relation(fields: [courseId], references: [id])
  gradingSystem   GradingSystem?        @relation(fields: [gradingSystemId], references: [id], onDelete: SetNull)
  slots           GroupScheduleSlot[]
  teachers        GroupTeacher[]
  supportTeachers GroupSupportTeacher[]
  daysOff         GroupDayOff[]
  lessons         Lesson[]
  notes           GroupNote[]
  memberships     GroupMembership[]
  studentComments StudentComment[]

  @@index([branchId, status])
  @@index([courseId])
}

/// One meeting per weekday (1 = Monday … 7 = Sunday), "HH:mm" times.
model GroupScheduleSlot {
  id        String  @id @default(cuid())
  groupId   String
  weekday   Int
  startTime String
  endTime   String
  roomId    String?

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  room  Room? @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@unique([groupId, weekday])
  @@index([roomId])
}

model GroupTeacher {
  id         String           @id @default(cuid())
  groupId    String
  userId     String
  role       GroupTeacherRole @default(MAIN)
  shareType  ShareType        @default(PERCENT)
  shareValue Decimal          @db.Decimal(15, 2)
  since      DateTime         @db.Date

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
  @@index([userId])
}

model GroupSupportTeacher {
  groupId String
  userId  String

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation("supportOf", fields: [userId], references: [id])

  @@id([groupId, userId])
  @@index([userId])
}

/// "Dam berish": a day the group does not meet; its lesson is removed (A-53).
model GroupDayOff {
  id      String   @id @default(cuid())
  groupId String
  date    DateTime @db.Date
  reason  String

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, date])
}

/// One meeting of a group, generated from the schedule or added as an extra lesson.
model Lesson {
  id            String   @id @default(cuid())
  groupId       String
  date          DateTime @db.Date
  startTime     String
  endTime       String
  topic         String?
  attachmentUrl String?
  isExtra       Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  attendances Attendance[]
  grades      Grade[]

  @@unique([groupId, date, startTime])
  @@index([groupId, date])
}

/// Student (EXP §6 profile). Phase 5 created the minimal row; Phase 6 adds the
/// profile fields, parents, custom fields, comments and payments.
model Student {
  id            String    @id @default(cuid())
  branchId      String
  fullName      String
  phone         String?
  gender        Gender    @default(MALE)
  birthDate     DateTime? @db.Date
  photoUrl      String?
  /// Student app login (A-06): stored as observed, no app or portal in v1.
  passwordHash  String?
  /// "Manba": a lead source; the catalogue gets its own pages with leads (Phase 7).
  sourceId      String?
  schoolId      String?
  note          String?
  isBlacklisted Boolean   @default(false)
  isArchived    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  branch       Branch               @relation(fields: [branchId], references: [id])
  school       School?              @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  source       LeadSource?          @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  memberships  GroupMembership[]
  parents      Parent[]
  customFields StudentCustomField[]
  comments     StudentComment[]
  payments     Payment[]

  @@index([branchId, isArchived])
  @@index([phone])
  @@index([schoolId])
  @@index([sourceId])
}

model GroupMembership {
  id          String           @id @default(cuid())
  groupId     String
  studentId   String
  status      MembershipStatus @default(ACTIVE)
  joinedAt    DateTime         @db.Date
  leftAt      DateTime?        @db.Date
  customPrice Decimal?         @db.Decimal(15, 2)
  note        String?
  /// First day the student is charged: when the membership became ACTIVE (A-10).
  activatedAt DateTime?        @db.Date
  /// Set while FROZEN: lessons from this day on are not charged (A-59).
  frozenAt    DateTime?        @db.Date
  /// Why the student left (EXP §10 churn report reasons); free text until Phase 12.
  leaveReason String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student     Student      @relation(fields: [studentId], references: [id])
  attendances Attendance[]
  grades      Grade[]
  discounts   Discount[]
  charges     Charge[]
  payments    Payment[]

  @@unique([groupId, studentId])
  @@index([studentId])
}

model Attendance {
  lessonId     String
  membershipId String
  status       AttendanceStatus @default(NOT_MARKED)
  comment      String?
  markedById   String?
  markedAt     DateTime         @default(now())

  lesson     Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  membership GroupMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([lessonId, membershipId])
}

model Grade {
  lessonId     String
  membershipId String
  score        Decimal  @db.Decimal(6, 2)
  comment      String?
  gradedById   String?
  gradedAt     DateTime @default(now())

  lesson     Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  membership GroupMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([lessonId, membershipId])
}

model GroupNote {
  id        String   @id @default(cuid())
  groupId   String
  authorId  String?
  text      String
  createdAt DateTime @default(now())

  group  Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([groupId, createdAt])
}

// ---------------------------------------------------------------------------
// Phase 6: students, payments, discounts, receipts (EXP §6, §5 "To'lov",
// §5 CHEGIRMALAR / O'QUVCHIGA IZOH, §8 Chek sozlamalari, §11 TO'LOV)
// ---------------------------------------------------------------------------

/// "Manba" on the student and lead forms. Managed on the lead sources page (Phase 7).
model LeadSource {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  students     Student[]

  @@unique([organizationId, name])
}

/// "Ota-onasi" tab: name and phone, bulk SMS arrives in Phase 11.
model Parent {
  id        String   @id @default(cuid())
  studentId String
  fullName  String
  phone     String
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

/// "O'quvchiga qo'shimcha ma'lumot qo'shish": a named value on the profile card.
model StudentCustomField {
  id        String   @id @default(cuid())
  studentId String
  name      String
  value     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, name])
}

/// "Izoh va eslatmalar" on the student, also listed per group ("O'quvchiga izoh").
model StudentComment {
  id          String   @id @default(cuid())
  studentId   String
  groupId     String?
  text        String
  createdById String?
  createdAt   DateTime @default(now())

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group     Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
  @@index([groupId, createdAt])
}

/// "Chegirma": a reduced monthly price for the next `months` charges (A-10).
/// Remaining months = months − charges that used this discount.
model Discount {
  id              String   @id @default(cuid())
  membershipId    String
  discountedPrice Decimal  @db.Decimal(15, 2)
  amount          Decimal  @db.Decimal(15, 2) // course price − discounted price
  months          Int
  givenAt         DateTime @db.Date
  comment         String?
  createdById     String?
  createdAt       DateTime @default(now())

  membership GroupMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  createdBy  User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  charges    Charge[]

  @@index([membershipId])
}

/// One monthly fee per membership and course month (A-10). `month` is the first
/// day of the month; the amount is pro-rated by the lessons the student is in.
model Charge {
  id             String   @id @default(cuid())
  membershipId   String
  month          DateTime @db.Date
  price          Decimal  @db.Decimal(15, 2) // monthly price used (course, custom or discounted)
  amount         Decimal  @db.Decimal(15, 2)
  lessonsTotal   Int
  lessonsCounted Int
  discountId     String?
  createdAt      DateTime @default(now())

  membership GroupMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  discount   Discount?       @relation(fields: [discountId], references: [id], onDelete: SetNull)

  @@unique([membershipId, month])
}

/// "To'lov" (EXP §5 payment form, §6 payment history, §11 TO'LOV).
model Payment {
  id              String   @id @default(cuid())
  studentId       String
  membershipId    String
  branchId        String
  paymentMethodId String?
  amount          Decimal  @db.Decimal(15, 2)
  bonus           Decimal  @default(0) @db.Decimal(15, 2) // "O'quvchiga bonus"
  /// "Tasir vaqti": the course month this payment is for (first day of the month).
  effectiveMonth  DateTime @db.Date
  paidAt          DateTime @db.Date
  comment         String?
  receivedById    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  student       Student         @relation(fields: [studentId], references: [id])
  membership    GroupMembership @relation(fields: [membershipId], references: [id])
  branch        Branch          @relation(fields: [branchId], references: [id])
  paymentMethod PaymentMethod?  @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  receivedBy    User?           @relation(fields: [receivedById], references: [id], onDelete: SetNull)
  refunds       Refund[]

  @@index([studentId, paidAt])
  @@index([membershipId])
  @@index([branchId, paidAt])
  @@index([effectiveMonth])
}

/// "Pul qaytarish": part or all of one payment given back.
model Refund {
  id           String   @id @default(cuid())
  paymentId    String
  amount       Decimal  @db.Decimal(15, 2)
  reason       String?
  refundedById String?
  createdAt    DateTime @default(now())

  payment    Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  refundedBy User?   @relation(fields: [refundedById], references: [id], onDelete: SetNull)

  @@index([paymentId])
}

enum ReceiptLogoPosition {
  TOP
  BOTTOM
}

/// "Chek sozlamalari" (EXP §8): what the printed receipt shows.
model ReceiptSettings {
  id             String              @id @default(cuid())
  organizationId String              @unique
  address        String?
  phone          String?
  visibleFields  String[]            @default([])
  logoPosition   ReceiptLogoPosition @default(TOP)
  footerText     String?
  updatedAt      DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}
