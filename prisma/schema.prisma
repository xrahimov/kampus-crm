// Kampus CRM — Prisma schema.
// Phase 2 (skeleton): organisation, branches, users, roles, sessions, logs.
// Later phases add their own models in the sections marked below.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Organisation & branches (EXP §0 branch selector, §8 general settings)
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches       Branch[]
  settings       OrgSettings?
  paymentMethods PaymentMethod[]
  gradingSystems GradingSystem[]
  schools        School[]
}

model Branch {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  users        UserBranch[]
  sessions     Session[]
  auditLogs    AuditLog[]
  courses      Course[]
  rooms        Room[]
  daysOff      DayOff[]

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Users, roles, permissions (EXP §8 Staff, Roles)
// ---------------------------------------------------------------------------

enum Gender {
  MALE
  FEMALE
}

/// How a teacher is paid (EXP §4 "Maosh hisoblash usuli"); see A-12.
enum SalaryMethod {
  PERCENT
  MONTHLY
  PER_LESSON
  PER_STUDENT
}

model User {
  id            String        @id @default(cuid())
  fullName      String
  phone         String        @unique // E.164, e.g. +998901234567
  passwordHash  String
  gender        Gender        @default(MALE)
  birthDate     DateTime?     @db.Date
  hireDate      DateTime?     @db.Date
  photoUrl      String?
  salaryMethod  SalaryMethod?
  fixedSalary   Decimal?      @db.Decimal(15, 2) // MONTHLY: UZS per month
  percentShare  Decimal?      @db.Decimal(5, 2) // PERCENT: % of course price
  perLessonFee  Decimal?      @db.Decimal(15, 2) // PER_LESSON: UZS per lesson
  perStudentFee Decimal?      @db.Decimal(15, 2) // PER_STUDENT: UZS per active student
  isArchived    Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  roles     UserRole[]
  branches  UserBranch[]
  sessions  Session[]
  loginLogs LoginLog[]
  auditLogs AuditLog[]
}

/// A role is a named bundle of permission codes. System roles are seeded and
/// cannot be deleted; the CEO can create custom roles (EXP §8 Roles (Beta)).
model Role {
  id          String   @id @default(cuid())
  code        String   @unique // e.g. CEO, ADMIN, TEACHER, or custom:branch-manager
  name        String
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  permissions String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users UserRole[]
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model UserBranch {
  userId   String
  branchId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@index([branchId])
}

// ---------------------------------------------------------------------------
// Auth: sessions, login rate limiting, login log (EXP §8 "Tizimga kirishlar")
// ---------------------------------------------------------------------------

model Session {
  id             String   @id @default(cuid())
  tokenHash      String   @unique // sha256 of the opaque cookie token
  userId         String
  activeBranchId String?
  csrfSecret     String
  ip             String?
  userAgent      String?
  expiresAt      DateTime
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeBranch Branch? @relation(fields: [activeBranchId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
}

/// One row per failed login, keyed by phone and by IP. Counted in a sliding
/// window to lock out brute force (see server/auth/rate-limit.ts).
model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model LoginLog {
  id        String   @id @default(cuid())
  userId    String?
  phone     String
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Audit log for every create/update/delete (EXP §5 group history,
// §6 student history, §8 action log)
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  branchId  String?
  action    String // e.g. group.update
  entity    String // e.g. Group
  entityId  String
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  actor  User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([entity, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Settings core (Phase 3, EXP §8 "Umumiy sozlamalar", Kurslar, Xonalar,
// Dam olish kunlari, Maktablar)
// ---------------------------------------------------------------------------

/// The switches on the "Markaz sozlamalari" tab, one row per organisation.
/// Each flag is read by the module it governs in a later phase.
model OrgSettings {
  id             String @id @default(cuid())
  organizationId String @unique

  spreadOverpayment          Boolean @default(false) // overpayment is spread over the next months
  adminActionsNeedApproval   Boolean @default(false) // admin actions wait for CEO approval (A-09)
  printReceiptAfterPayment   Boolean @default(false)
  refundsEnabled             Boolean @default(false)
  attendanceComments         Boolean @default(false)
  teachersSeeExamSchedule    Boolean @default(false)
  attendanceOnlyDuringLesson Boolean @default(false)
  teacherSeesSalary          Boolean @default(false)
  payTeacherOnGroupDayOff    Boolean @default(false)
  payOnlyAttendedLessons     Boolean @default(false)
  teacherCanAddStudents      Boolean @default(false)
  bookAnySupportTeacher      Boolean @default(false)
  groupSupportSessions       Boolean @default(false)

  workStart           String @default("08:00") // HH:mm, schedule grid start
  workEnd             String @default("20:00") // HH:mm, schedule grid end
  scheduleStepMinutes Int    @default(30) // 15 or 30

  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// "To'lov usullari" on the general settings tab. Payments reference these from Phase 6.
model PaymentMethod {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
}

enum RoundingType {
  STANDARD
  IELTS
}

/// "Baholash tizimlari": a named scale with ordered levels (A-16).
model GradingSystem {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  rounding       RoundingType @default(STANDARD)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  levels       GradingLevel[]
  courses      Course[]

  @@unique([organizationId, name])
}

model GradingLevel {
  id              String  @id @default(cuid())
  gradingSystemId String
  name            String
  minScore        Decimal @db.Decimal(6, 2)
  maxScore        Decimal @db.Decimal(6, 2)
  sortOrder       Int     @default(0)

  gradingSystem GradingSystem @relation(fields: [gradingSystemId], references: [id], onDelete: Cascade)

  @@index([gradingSystemId, sortOrder])
}

/// "Kurslar": per branch, with a monthly price and duration in months.
model Course {
  id              String   @id @default(cuid())
  branchId        String
  name            String
  description     String?
  price           Decimal  @db.Decimal(15, 2) // UZS per month
  durationMonths  Int
  gradingSystemId String?
  color           String? // hex, e.g. #0F766E
  isArchived      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  branch        Branch         @relation(fields: [branchId], references: [id])
  gradingSystem GradingSystem? @relation(fields: [gradingSystemId], references: [id], onDelete: SetNull)

  @@index([branchId, isArchived])
  @@index([gradingSystemId])
}

/// "Xonalar": per branch, with a seat capacity.
model Room {
  id        String   @id @default(cuid())
  branchId  String
  name      String
  capacity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([branchId, name])
}

/// "Dam olish kunlari": a date on which the branch holds no lessons.
model DayOff {
  id        String   @id @default(cuid())
  branchId  String
  date      DateTime @db.Date
  reason    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([branchId, date])
}

/// "Maktablar": the schools students attend (students reference them from Phase 6).
model School {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
}
